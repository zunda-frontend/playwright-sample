{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "e2e-test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "e2e-test:ui": {
      "env": ["DISPLAY"],
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
